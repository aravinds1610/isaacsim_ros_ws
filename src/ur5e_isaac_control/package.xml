<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5e_isaac_control</name>
  <version>0.0.1</version>
  <description>Joint control scripts for a UR5e arm simulated in Isaac Sim over ROS2</description>
  <maintainer email="aravind162000@gmail.com">aravindsuresh16</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <!-- MoveIt2 bring-up (launch/moveit.launch.py) -->
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <!-- M1b: gripper meshes referenced by urdf/ur5e_gripper.urdf.xacro.
       NOTE deliberately no dependency on ur5e_gripper_moveit_config: that
       package exec_depends on THIS one (its config references our URDF), so
       depending on it back is a cycle colcon refuses to order. Its SRDF is
       copied into config/ instead - see config/ur5e_gripper.srdf. -->
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
