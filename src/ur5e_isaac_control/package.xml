<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5e_isaac_control</name>
  <version>0.0.1</version>
  <description>Joint control scripts for a UR5e arm simulated in Isaac Sim over ROS2</description>
  <maintainer email="aravind162000@gmail.com">aravindsuresh16</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <!-- Message packages imported by the nodes. Keep this list in step with the
       imports: anything imported but undeclared only works by luck, because
       some other package happened to pull it into /opt/ros. -->
  <depend>control_msgs</depend>          <!-- trajectory_bridge: FollowJointTrajectory -->
  <depend>geometry_msgs</depend>         <!-- cube_pose_publisher, pick_orchestrator -->
  <depend>moveit_msgs</depend>           <!-- pick_orchestrator: MoveGroup action -->
  <depend>shape_msgs</depend>            <!-- pick_orchestrator: SolidPrimitive -->
  <depend>std_srvs</depend>              <!-- pick_orchestrator: Trigger -->
  <depend>tf2_ros</depend>               <!-- cube_pose_publisher: StaticTransformBroadcaster -->
  <depend>trajectory_msgs</depend>       <!-- carried inside FollowJointTrajectory goals -->
  <depend>visualization_msgs</depend>    <!-- cube_pose_publisher: /cube_marker -->

  <!-- Third-party python. NOTE ikpy (kinematics.py) is deliberately absent:
       it has no rosdep key, so declaring it would break `rosdep install`.
       Install it user-local with pip (user, no-deps; break-system-packages on 24.04). -->
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>        <!-- apriltag_pose: cv2 -->

  <!-- MoveIt2 bring-up (launch/moveit.launch.py) -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <!-- M1b: gripper meshes referenced by urdf/ur5e_gripper.urdf.xacro.
       NOTE deliberately no dependency on ur5e_gripper_moveit_config: that
       package exec_depends on THIS one (its config references our URDF), so
       depending on it back is a cycle colcon refuses to order. Its SRDF is
       copied into config/ instead - see config/ur5e_gripper.srdf. -->
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
